# --- Eurosatory Scraper environment ---

# Finderr Cloud public API (key visible in front-end bundle, no auth required for public catalog).
# Override only if Eurosatory changes the host/key.
FINDERR_BASE_URL=https://eurosatory.finderr.cloud/api/
FINDERR_API_KEY=55d2a5d23487234d2a83fc3c50b94e5bbfd66e8595d847230af8ec4cbb9f4a8c
FINDERR_LANGUAGE=en

# Identify ourselves transparently (RGPD / robots good citizenship).
HTTP_USER_AGENT=eurosatory-scraper/0.1 (+contact: a.bertantoine@gmail.com)

# Rate limiting (seconds between requests on a given host)
SCRAPE_PER_HOST_DELAY=1.0
SCRAPE_TIMEOUT=20
SCRAPE_MAX_RETRIES=3
SCRAPE_CONCURRENCY=8

# Database (SQLite by default, switch to postgres for prod)
DATABASE_URL=sqlite:///data/eurosatory.db

# API & UI
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# --- Deep crawl (intelligence layer) ---
DEEP_CRAWL_MAX_PAGES=15
DEEP_CRAWL_MAX_PDFS=3
DEEP_CRAWL_MAX_DEPTH=2
DEEP_CRAWL_PER_HOST_DELAY=2.0
DEEP_CRAWL_TIMEOUT=20
DEEP_CRAWL_CONCURRENCY=4
DEEP_CRAWL_MAX_PAGE_BYTES=2000000

# --- LLM enrichment (optional, for premium output) ---
# Leave empty to use the deterministic rule-based extractor only.
ANTHROPIC_API_KEY=
LLM_INTELLIGENCE_MODEL=claude-haiku-4-5
LLM_INTELLIGENCE_BUDGET_TOKENS=2500

# Logs
LOG_LEVEL=INFO
LOG_DIR=data/logs
