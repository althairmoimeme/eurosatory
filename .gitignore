# --- Project data ---
# Full dev DB (heavy: crawled_pages, raw enrichment) — kept local only.
# We ship the slim ``eurosatory_deploy.db`` instead, which contains
# only what the read-only UI needs.
/data/eurosatory.db
/data/eurosatory.db-*
/data/eurosatory.db.backup
/data/logs/
/data/raw/
/_tests/

