# --- Streamlit secrets template ---
# Copy this file to ``.streamlit/secrets.toml`` for local testing
# (it's git-ignored), or paste these keys into Streamlit Cloud's
# "Secrets" UI when deploying.
#
# All keys are OPTIONAL except APP_PASSWORD if you want auth.

# Password gate — leave blank to disable (open access).
APP_PASSWORD = "change-me-before-deploying"

# Anthropic API (for the LLM enrichment scripts only — UI does not
# call the LLM at runtime, so this can stay empty for a read-only
# demo deploy).
ANTHROPIC_API_KEY = ""

# Enrich.so (LinkedIn employee finder + email finder)
ENRICH_SO_API_KEY = ""

# FullEnrich / RocketReach (if used by the scraper)
FULLENRICH_API_KEY = ""
ROCKETREACH_API_KEY = ""

# Database URL override.  Default is ``sqlite:///data/eurosatory.db``
# (or the slim ``eurosatory_deploy.db`` if the full one is missing).
# Leave commented out for the auto-fallback to kick in.
# DATABASE_URL = "sqlite:///data/eurosatory_deploy.db"
