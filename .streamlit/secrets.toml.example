# --- LeadForges · Streamlit secrets template ---
#
# Copy this file to ``.streamlit/secrets.toml`` for local testing
# (it's git-ignored), or paste these keys into Streamlit Cloud's
# "Secrets" UI when deploying.
#
# ╔══════════════════════════════════════════════════════════════╗
# ║  Multi-buyer authentication (the LeadForges way)             ║
# ╠══════════════════════════════════════════════════════════════╣
# ║                                                              ║
# ║  Each ``[[buyers]]`` entry = one paying customer. Add one    ║
# ║  per sale via ``python -m scripts.grant_access``.            ║
# ║                                                              ║
# ║  Required fields :                                           ║
# ║    password   – 16+ random chars, generated at sale time     ║
# ║    name       – buyer display name (shown in the UI banner)  ║
# ║    expires    – ISO date YYYY-MM-DD (access is auto-revoked) ║
# ║                                                              ║
# ║  Optional fields :                                           ║
# ║    email      – buyer contact (audit-only)                   ║
# ║                                                              ║
# ╚══════════════════════════════════════════════════════════════╝

[[buyers]]
password = "REPLACE_WITH_16_CHARS_PASSWORD"
name     = "Demo Buyer"
expires  = "2026-12-31"
email    = "demo@example.com"

# Add more buyers by duplicating the block :
#
# [[buyers]]
# password = "Hgs7K2pXq9mNwR3v"
# name     = "Thales Group"
# expires  = "2026-11-30"
# email    = "contact@thales.com"


# ── Legacy single-password fallback (optional) ──────────────────
# If no [[buyers]] entries are configured AND this value is set,
# the app falls back to a single shared password. Useful for local
# dev or grandfathered single-tenant deploys.
APP_PASSWORD = ""


# ── External API keys (for the backend enrichment pipeline) ─────
# The UI itself does not call these at runtime, so they can stay
# empty for a read-only client deploy.
ANTHROPIC_API_KEY = ""
ENRICH_SO_API_KEY = ""
FULLENRICH_API_KEY = ""
ROCKETREACH_API_KEY = ""

# Database URL override. Default = sqlite slim deploy DB shipped
# with the repo. Leave commented unless you point at a hosted DB.
# DATABASE_URL = "sqlite:///data/eurosatory_deploy.db"
